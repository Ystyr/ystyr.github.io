#define MAX_STEPS 100
#define MAX_DIST 100.
#define SURF_DIST .001

#define S smoothstep
#define TROLL T * .25

const float shellW = .03;
const float ballR = 1.;
const float gScale = 10.;

const vec3 lightCol = vec3(1., .5, .75);
const vec3 lMod = vec3(1., .75, .5);

float sumVec(vec3 v) {
    return v.x + v.y + v.z;
}

float hash21(vec2 p)
{
    p = fract(p * vec2(123.345, 234.532));
    p += dot(p, p + 23.4);
    return fract(p.x * p.y);
}

float sdBall(vec3 p, float r, float a, float s)
{
    p.yz *= rotate2d(TROLL);
    vec3 st = p * s;
    vec3 q = st;
    float g = abs(.7 * dot(sin(q + T * .25), cos(q.yzx - T * .25)) / s) - a;
    float ballShape = abs(length(p) - r) - a - .005;

    return smin(ballShape, g, -a);
}

float ball(vec3 p) {
    return sdBall(p, ballR, shellW * .75, gScale);
}

float sdGround(vec3 p)
{
    vec3 ofst = vec3(0., 0., -TROLL);
    vec3 st = ((p + ofst) * gScale * .5);
    vec3 q = st + vec3(cos(st.z + st.x * .25), sin(st.z), cos(st.z - st.x * .25));
    float grd = abs(dot(sin(q), cos(q.yzx))) * .5;

    return p.y + .99 + grd * .1;
}

float getDist(vec3 p, out bool isGround)
{
    float ballD = ball(p);
    float ground = sdGround(p);
    float d = min(ballD, ground);

    isGround = ballD > ground;

    return d;
}

float getDistNoFlag(vec3 p) {
    return min(ball(p), sdGround(p));
}

float sdGlitter(vec2 uv, float f)
{
    vec2 st = uv * 110.;
    vec2 gst = fract(st) - .5;
    vec2 gid = floor(st);
    float n = hash21(mod(gid, 100.));
    float d = length(gst);
    float m = S(.5 * n, 0., d);
    m *= pow(halfUp(sin(f + fract(n * 100.) * TWO_PI)), 80.);
    m *= halfUp(cos(n * 30.));
    return m;
}

float traceDist(vec3 ro, vec3 rd, inout bool isGround) {
    float dO = 0.;

    for (int i = 0; i < MAX_STEPS; i++) {
        vec3 p = ro + rd * dO;
        float dS = getDist(p, isGround);
        dO += dS;
        if (dO > MAX_DIST || abs(dS) < SURF_DIST) break;
    }

    return dO;
}

vec3 getNormal(vec3 p) {
    float d = getDistNoFlag(p);
    vec2 e = vec2(.001 * texture(u_sampler0, p.xz * 3.).r, 0.);
    vec3 n = d - vec3(
        getDistNoFlag(p - e.xyy),
        getDistNoFlag(p - e.yxy),
        getDistNoFlag(p - e.yyx));

    return normalize(n);
}

vec3 getGroundColor(vec3 p, vec3 ro, vec3 col, vec3 lDir, vec3 lInDir, float glitter, float cd)
{
    float s = ball(-lInDir);
    float w = cd * .035 - .025;
    float shad = S(-w, w, s);

    col *= shad * .9 + .1;
    p.z -= TROLL;

    float sand = texture(u_sampler0, p.xz * 3.).r * .5;
    vec3 glitCol = lDir + vec3(.1, .5, .2);

    glitter *= pow(shad, 4.) * 3.5;

    col += glitter * (glitCol * .6);
    col /= cd * cd * cd;
    col *= lMod + sand;

    return col;
}

vec3 getBallColor(vec3 p, vec3 ro, vec3 n, vec3 col, vec3 refl, vec2 dif, float cd)
{
    col *= 1. - refl.xzy * .3;
    col *= mix(lMod, refl, 1. - dif.x).gbr * lMod;
    col *= mix(lMod, vec3(dif.x), cd);
    col += dif.y * lightCol * lMod * pow(-p.y + .75, 2.) * .5;

    return col;
}

void main()
{
    vec2 uv = (FRAG_XY * 2. - 1.) / RES.y * RES.xy;
    vec2 m = vec2(- pow(halfUp(.75 - sin(T * .05)), 2.) * .5, .5); //MSE.xy / RES.xy;

    vec3 ro = vec3(0., 1.7, -1.7) * .7;
    ro.yz *= rotate2d(-m.y * PI + 1.);
    ro.y = max(-.9, ro.y);
    ro.xz *= rotate2d(-m.x * TWO_PI);

    bool isGround = false;
    vec3 rd = getRayDir(uv, ro, vec3(0.), 1.);
    float cdSq = dot(uv, uv);
    float light = .002 / cdSq;
    float d = traceDist(ro, rd, isGround);

    vec3 col = vec3(0.);

    if (d < MAX_DIST) {
        vec3 p = ro + rd * d;
        vec3 n = getNormal(p);
        vec3 refl = reflect(rd, n);
        vec3 lInDir = -normalize(p);
        vec3 lDir = max(lInDir, reflect(p, n));
        float dif = halfUp(dot(n, lDir));
        float dif2 = S(1., -1., dif * 16.);
        float cd = length(p);

        col = vec3(dif * 1.75) * lMod * vec3(.9, .8, 1.2);

        if (isGround) {
            vec2 glUv = p.xz;
            glUv.y -= TROLL;
            float glitter = sdGlitter(glUv, sumVec(ro) - T * 2.);
            col = getGroundColor(p, ro, col, lDir, lInDir, glitter, cd);
        }
        else {
            col = getBallColor(p, ro, n, col, refl, vec2(dif, dif2), cd);
            vec3 refRO = p + n * SURF_DIST * 1.5;
            bool refIsGround = false;
            float refDist = traceDist(refRO, refl, refIsGround);
            if (refDist < MAX_DIST) {
                vec3 refHit = refRO + refl * refDist;
                vec3 refHitN = getNormal(refHit);
                float refHitDif = halfUp(dot(refHitN, lDir));

                if (refIsGround) {
                    vec3 refGrCol = getGroundColor(refHit, refRO, col, lInDir, lDir, 0., cd);
                    col = min(vec3(1.), min((col + refGrCol) * .5, refGrCol * .85 + .25) * 1.5) * lMod;
                }
                else {
                    vec3 refBalCol = getBallColor(
                        refHit, refRO, refHitN, col, reflect(refHit, refHitN),
                        vec2(refHitDif, S(1., -1., refHitDif * 16.)), cd
                    );
                    col = min(col, refBalCol * .75 + .35) * lMod;
                }
            }
        }
    }

    light = light * S(.0, .5, d - 2.);
    light += light * S(.0, .01, ball(normalize(ro)) * .5);

    col += light * lightCol;

    float gs = max(0., sumVec(col) * .333);
    col = mix(col * (col + gs), gs * vec3(gs), 1. - gs);
    col = pow(col, vec3(.4545));

    FRAG_OUT = vec4(col, 1.);
}
